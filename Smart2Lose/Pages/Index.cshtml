@page
@model IndexModel
@{
    ViewData["Title"] = "2Smart2Lose";
}

<link rel="stylesheet" href="~/css/Index.css" asp-append-version="true" />

<!-- Header -->
<header class="site-header">
    <div class="site-logo">2Smart2Lose</div>
    <button class="btn-login" onclick="window.location.href='/Account/Login'">Admin Login</button>
</header>

<!-- Hero -->
<main class="hero">
    <div class="hero-inner">

        <h1 class="hero-title">2Smart2Lose</h1>
        <p class="hero-subtitle">Gib deinen Game-PIN ein und tritt dem Quiz bei.</p>

        <div class="pin-card">
            <form method="post">
                <label class="pin-label" for="GameID">Game-PIN</label>
                <div class="pin-input-wrap">
                    <input type="number"
                           id="GameID"
                           asp-for="session.GameID"
                           value=""
                           required
                           placeholder="z. B. 4821"
                           autocomplete="off"
                           inputmode="numeric" />

                    <button type="submit" class="btn-join">Beitreten</button>
                </div>

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="pin-error">@Model.ErrorMessage</div>
                }
            </form>
        </div>


    </div>
</main>

