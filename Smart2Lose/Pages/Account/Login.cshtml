@page
@model LoginModel
@{
    ViewData["Title"] = "Login";
}

<link rel="stylesheet" href="~/css/Admin/AUTH.css" asp-append-version="true" />

<header class="auth-header">
    <a href="/Index" class="auth-logo">2Smart2Lose</a>
</header>

<main class="auth-main">
    <div class="auth-inner">

        <h1 class="auth-title">Anmelden</h1>
        <p class="auth-subtitle">Melde dich mit deinem Admin-Konto an.</p>

        <div class="auth-card">
            <form method="post">

                <div asp-validation-summary="All" class="auth-error"></div>

                <div class="auth-field">
                    <label asp-for="Input.Email" class="auth-label"></label>
                    <input asp-for="Input.Email" class="auth-input" placeholder="name@beispiel.de" />
                    <span asp-validation-for="Input.Email" class="auth-validation"></span>
                </div>

                <div class="auth-field">
                    <label asp-for="Input.Password" class="auth-label"></label>
                    <input asp-for="Input.Password" class="auth-input" placeholder="••••••••" />
                    <span asp-validation-for="Input.Password" class="auth-validation"></span>
                </div>

                <button type="submit" class="auth-btn">Anmelden</button>

            </form>

            <div class="auth-links">
                <a asp-page="/Account/Register">Noch kein Konto? Registrieren</a>
            </div>
        </div>

    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
