@page
@model Smart2Lose.Pages.Admin.DashboardModel
@{
    ViewData["Title"] = "Kahoot | Admin Dashboard";
}

<link rel="stylesheet" href="~/css/Admin/GrundDashboard.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/Admin/Dashboard.css" asp-append-version="true" />

<!-- Header -->
<header class="header">
    <div class="logo">@Model.pn.Name</div>
    <nav class="nav-links">
        <a href="/Admin/Dashboard" class="active">Dashboard</a>

        @if (User.IsInRole("Admin"))
        {
            <a href="/Admin/ManageUser">User</a>
        }
        @if (User.IsInRole("Admin") || User.IsInRole("User") || User.IsInRole("ReadOnly"))
        {
            <a href="/Admin/Frageboegen">Fragebögen</a>
        }
        @if (User.IsInRole("Admin") || User.IsInRole("User"))
        {
            <a href="/Admin/FrageboegenErstellen">Neue anlegen</a>
        }

        @if (User.IsInRole("Admin"))
        {
            <a href="/Admin/Rollenantraege">Anträge @if (Model.AusstehendAntraege > 0) { <span class="nav-antrag-dot">@Model.AusstehendAntraege</span> }</a>
        }
        @if (User.IsInRole("ReadOnly"))
        {
            <a href="/Admin/Antrag">Antrag</a>
        }

        <a href="/Index">Quit</a>
    </nav>
</header>

<!-- Seitentitel -->
<div class="seiten-titel-bereich">
    <h1 class="seiten-titel">Dashboard</h1>
</div>

<div class="dashboard-container">

    <!-- KPI: Alle User -->
    <div class="section-label">Übersicht</div>
    <div class="kpi-grid">
        <div class="kpi-karte">
            <div class="kpi-icon"><i class="fa-solid fa-clipboard-list"></i></div>
            <div class="kpi-label">Gesamt-Quizze</div>
            <div class="kpi-wert">@Model.GesamtQuizze</div>
        </div>
        <div class="kpi-karte">
            <div class="kpi-icon"><i class="fa-solid fa-gamepad"></i></div>
            <div class="kpi-label">Gesamt-Spiele</div>
            <div class="kpi-wert">@Model.GesamtSpiele</div>
        </div>
        <div class="kpi-karte">
            <div class="kpi-icon"><i class="fa-solid fa-calendar-day"></i></div>
            <div class="kpi-label">Spiele heute</div>
            <div class="kpi-wert">@Model.SpieleHeute</div>
        </div>
        <div class="kpi-karte">
            <div class="kpi-icon"><i class="fa-solid fa-users"></i></div>
            <div class="kpi-label">Gesamt-Teilnehmer</div>
            <div class="kpi-wert">@Model.GesamtTeilnehmer</div>
        </div>
    </div>

    <!-- KPI: Nur Admin -->
    @if (User.IsInRole("Admin"))
    {
        <div class="kpi-grid" style="margin-top:1rem; grid-template-columns: repeat(4,1fr);">
            <div class="kpi-karte admin-only">
                <div class="kpi-icon"><i class="fa-solid fa-user-shield"></i></div>
                <div class="kpi-label">Registrierte User</div>
                <div class="kpi-wert">@Model.RegistrierteUser</div>
                <div class="kpi-badge-admin">Nur Admin</div>
            </div>
        </div>
    }

    <!-- DB Status (Admin) -->
    @if (User.IsInRole("Admin"))
    {
        <div class="section-label">Datenbankstatus</div>
        <div class="stat-karte">
            <div class="stat-karte-kopf">
                <span class="stat-karte-titel">
                    <i class="fa-solid fa-database"></i>
                    MySQL Verbindung
                </span>
                <span class="rollen-badge admin">Nur Admin</span>
            </div>
            <div class="db-status-body">
                <div class="db-status-zeile">
                    <span class="db-status-dot @(Model.DbOnline ? "online" : "offline")"></span>
                    <span class="db-status-label">@(Model.DbOnline ? "Verbunden" : "Keine Verbindung")</span>
                    @if (Model.DbOnline)
                    {
                        <span class="db-latenz">@Model.DbLatenzMs ms</span>
                    }
                </div>
                @if (Model.DbOnline)
                {
                    <div class="db-stat-grid">
                        <div class="db-stat-item">
                            <div class="db-stat-label">Version</div>
                            <div class="db-stat-wert small">@Model.DbVersion</div>
                        </div>
                        <div class="db-stat-item">
                            <div class="db-stat-label">Aktive Verbindungen</div>
                            <div class="db-stat-wert">@Model.DbThreadsConnected</div>
                        </div>
                        <div class="db-stat-item">
                            <div class="db-stat-label">Abfragen gesamt</div>
                            <div class="db-stat-wert">@Model.DbGesamtAbfragen.ToString("N0")</div>
                        </div>
                        <div class="db-stat-item">
                            <div class="db-stat-label">Server-Laufzeit</div>
                            <div class="db-stat-wert small">@Model.DbUptime</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Tabelle: Letzte Spielsessions -->
    <div class="section-label">Letzte Spielsessions</div>
    <div class="stat-karte">
        <div class="stat-karte-kopf">
            <span class="stat-karte-titel">
                <i class="fa-solid fa-clock-rotate-left"></i>
                Letzte 10 Spiele
            </span>
            <span class="rollen-badge alle">Alle Rollen</span>
        </div>
        @if (Model.LetzteSpielSessions.Any())
        {
            <table class="stat-tabelle">
                <thead>
                    <tr>
                        <th>GamePin</th>
                        <th>Quiz-Titel</th>
                        <th>Spieler</th>
                        <th>Letzte Aktivität</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var session in Model.LetzteSpielSessions)
                    {
                        <tr>
                            <td><span class="pin-badge">@session.GamePin</span></td>
                            <td>@session.QuizTitel</td>
                            <td>@session.SpielerAnzahl</td>
                            <td class="text-gedaempft">@session.LetzteAktivitaet.ToString("dd.MM.yyyy · HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="leer-hinweis">Noch keine Spiele gespielt.</div>
        }
    </div>

    <!-- Tabelle: Quiz-Aktivität (Admin: alle, User: eigene) -->
    @if (User.IsInRole("Admin") || User.IsInRole("User"))
    {
        <div class="section-label">Quiz-Aktivität</div>
        <div class="stat-karte">
            <div class="stat-karte-kopf">
                <span class="stat-karte-titel">
                    <i class="fa-solid fa-chart-simple"></i>
                    Quizze &amp; Spielstatistik
                </span>
                @if (User.IsInRole("Admin"))
                {
                    <span class="rollen-badge admin">Admin: alle Quizze</span>
                }
                else
                {
                    <span class="rollen-badge gemischt">Nur deine Quizze</span>
                }
            </div>
            @if (Model.QuizAktivitaeten.Any())
            {
                <table class="stat-tabelle">
                    <thead>
                        <tr>
                            <th>Quiz-Titel</th>
                            <th>Kategorie</th>
                            <th>Spiele gespielt</th>
                            <th>Teilnehmer gesamt</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var quiz in Model.QuizAktivitaeten)
                        {
                            <tr>
                                <td>@quiz.Titel</td>
                                <td class="text-gedaempft">@quiz.Kategorie</td>
                                <td>@quiz.AnzahlSpiele</td>
                                <td>@quiz.GesamtTeilnehmer</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="leer-hinweis">
                    @if (User.IsInRole("Admin"))
                    {
                        <span>Noch keine Quizze vorhanden.</span>
                    }
                    else
                    {
                        <span>Du hast noch keine Quizze erstellt.</span>
                    }
                </div>
            }
        </div>
    }

    <!-- Dev-Bereich (nur Admin, aufklappbar) -->
    @if (User.IsInRole("Admin"))
    {
        <details class="dev-details">
            <summary>
                <i class="fa-solid fa-chevron-right"></i>
                Entwickler-Bereich
                <span class="kpi-badge-admin" style="margin:0 0 0 4px;">Nur Admin</span>
            </summary>
            <div class="dev-inner">
                <p>Datenbankverbindung testen und Testeinträge verwalten.</p>
                <form method="post" asp-page-handler="TestVerbindung" style="display:inline;">
                    <button type="submit" class="dev-knopf">Verbindung testen</button>
                </form>
                <form method="post" asp-page-handler="EintragHinzufuegen" style="display:inline;">
                    <button type="submit" class="dev-knopf">Eintrag hinzufügen</button>
                </form>
                <form method="post" asp-page-handler="EintraegeAnzeigen" style="display:inline;">
                    <button type="submit" class="dev-knopf">Einträge anzeigen</button>
                </form>
                <div class="dev-status">@Model.StatusMessage</div>
            </div>
        </details>
    }

</div>
