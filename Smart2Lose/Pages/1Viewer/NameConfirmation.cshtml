@page
@model Smart2Lose.Pages._1Viewer.NameConfirmationModel
@{
    ViewData["Title"] = "Kahoot | Namen eingeben";
}

<link rel="stylesheet" href="~/css/Playground/GrundViewer.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/Playground/NameConfirmation.css" asp-append-version="true" />

<!-- Header -->
<header class="header">
    <div class="logo">@Model.pn.Name</div>
    <nav class="nav-links">
        <a href="/Index">Quit</a>
    </nav>
</header>

<!-- Nickname-Karte -->
<div class="nc-wrapper">
    <div class="nc-karte">

        <div class="nc-icon">
            <i class="fa-solid fa-gamepad"></i>
        </div>

        <h1>Gleich geht es los!</h1>
        <p>Gib deinen Namen ein, um beizutreten</p>

        <form method="post">
            <input class="nc-input"
                   type="text"
                   asp-for="Nickname"
                   required
                   placeholder="Wie darf man dich nennen?" />

            <button type="submit" asp-page-handler="LogName" class="nc-btn">
                <i class="fa-solid fa-arrow-right"></i>
                Los geht's
            </button>
        </form>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="nc-fehler">
                <i class="fa-solid fa-circle-exclamation"></i>
                @Model.ErrorMessage
            </div>
        }

    </div>
</div>
